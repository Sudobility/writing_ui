{
  "name": "@sudobility/writing_ui",
  "version": "0.1.11",
  "description": "React web editor components for Fadewright: ScriptEditor (speed view, controlled contenteditable) and ElementStylePicker over a writing_core document",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "demo": "vite --config demo/vite.config.ts",
    "build": "tsc --noEmit && vite build --config demo/vite.config.ts"
  },
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "dependencies": {
    "@sudobility/writing_core": "^0.1.6",
    "@sudobility/writing_formats": "^0.1.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "jsdom": "~30.1.3",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~6.0.3",
    "vite": "~8.3.5",
    "vitest": "~4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/writing_ui.git"
  }
}
